// Prisma schema for the IELTS AI Learning Platform
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  STUDENT
  TEACHER
}

enum SkillType {
  LISTENING
  READING
  WRITING
  SPEAKING
}

enum TestType {
  LISTENING
  READING
  WRITING
  SPEAKING
  FULL_MOCK
}

/// Phase 20 — Tests Hub categorization for Reading/Listening tests only.
/// CAMBRIDGE tests are also the platform's one free-without-subscription
/// tier (see hasActiveAccess). FULL_MOCK tests aren't categorized by this —
/// they're their own "Mock Tests" hub tile regardless.
enum MockTestCategory {
  CAMBRIDGE
  GENERAL
}

/// Phase 34 — real difficulty badge for Reading/Listening test listings.
/// Nullable/optional on MockTest: every test that existed before this phase
/// has no difficulty set, and the badge simply doesn't render for those
/// rather than showing an invented value.
enum MockTestDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum SpeakingTaskStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE_NOT_GIVEN
  FILL_IN_BLANK
  MATCHING
  SHORT_ANSWER
  SENTENCE_COMPLETION
  SUMMARY_COMPLETION
}

enum SubmissionStatus {
  /// An unsubmitted, still-editable essay — never analyzed, never visible to a teacher.
  DRAFT
  PENDING
  IN_REVIEW
  REVIEWED
}

enum WritingTaskNumber {
  TASK_1
  TASK_2
}

/// Phase 42 — Part 2. Academic and General Training each have their own
/// real Task 1/Task 2, distinguished purely as authoring/display metadata.
enum WritingTrainingType {
  ACADEMIC
  GENERAL
}

enum WritingTaskCategory {
  GRAPH
  TABLE
  PROCESS
  MAP
  OPINION
  DISCUSSION
  PROBLEM_SOLUTION
  ADVANTAGES_DISADVANTAGES
}

enum WritingTaskStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  COMPLETED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELLED
}

enum BillingInterval {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PromoCodeType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum ArticleDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  /// Phase 36 — Part 10's explicit 4th tier, for articles authored specifically as IELTS Academic Reading practice.
  IELTS_ACADEMIC
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

enum VocabularyStatus {
  UNKNOWN
  LEARNING
  KNOWN
}

enum StudyActivityType {
  READING
  LISTENING
  VOCABULARY
  WRITING
  ARTICLE
  /// Phase 39 — credited at real submission time (not heartbeat, same anti-gaming reasoning as READING/LISTENING) from both the audio Speaking pipeline and the Speaking Practice Center.
  SPEAKING
}

enum AchievementCode {
  FIRST_READING_TEST
  FIRST_ARTICLE_COMPLETED
  VOCAB_100_WORDS
  WRITING_10_TASKS
  STREAK_30_DAYS
  /// Phase 26 additions
  STREAK_7_DAYS
  FIRST_WRITING_SUBMISSION
  FIRST_SPEAKING_SUBMISSION
  FIRST_PREMIUM_MONTH
}

/// Phase 26 — Subscription Management: which of the 3 real ways a student
/// ended up on an ACTIVE paid plan. Null for an organic TRIAL — there's
/// nothing to attribute yet.
enum PremiumSource {
  COIN_REDEMPTION
  ADMIN_GRANT
  DIRECT_PAYMENT
  /// Phase 30 — approved via the Telegram manual-purchase flow (no payment
  /// gateway involved) — see src/lib/premium-requests.ts. Kept distinct
  /// from DIRECT_PAYMENT (a real gateway charge) and ADMIN_GRANT (a
  /// no-payment courtesy grant) so Premium Analytics (Phase 29) stays
  /// accurate about how a student actually became Premium.
  TELEGRAM_PURCHASE
}

/// Phase 26 — Payment Architecture: the providers this layer is built to
/// support. Neither is connected to a real gateway yet — see
/// src/lib/payments/.
enum PaymentProvider {
  CLICK
  PAYME
}

// ---------------------------------------------------------------------------
// Auth — identity lives in Firebase Authentication; this table is the
// application-side profile row, linked back to Firebase by uid.
// ---------------------------------------------------------------------------

model User {
  id          String  @id @default(cuid())
  /// The Firebase Authentication uid — the single source of truth for identity.
  firebaseUid String  @unique
  name        String?
  email       String  @unique
  image       String?
  role        Role    @default(STUDENT)

  /// Daily Login Streak (dashboard header) — consecutive CALENDAR days this
  /// user has visited a dashboard page. Deliberately separate from the
  /// Phase 15 StudyStreak model (StudentProfile-only, gated behind 5 minutes
  /// of real study activity, tied to coin rewards): this one belongs on User
  /// because both Students and Teachers see it in the shared dashboard
  /// header, and it increments on mere visit, not on any study threshold.
  currentLoginStreak Int       @default(0)
  longestLoginStreak Int       @default(0)
  lastLoginDate      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentProfile StudentProfile?
  teacherProfile TeacherProfile?

  @@map("users")
}

// ---------------------------------------------------------------------------
// Profiles
// ---------------------------------------------------------------------------

model StudentProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  teacherId String?
  teacher   TeacherProfile? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  targetBandScore Float?
  /// Phase 15 — Student Profile fields, all optional (a student may never fill them in).
  countryGoal     String?
  universityGoal  String?
  personalGoal    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  results                Result[]
  writingSubmissions     WritingSubmission[]
  speakingSubmissions    SpeakingSubmission[]
  assignments            Assignment[]
  subscriptions          Subscription[]
  payments               Payment[]
  aiExplanationRequests  AiExplanationRequest[]
  studyPlans             StudyPlan[]
  writingAiActionLogs    WritingAiActionLog[]
  promoCodeRedemptions   PromoCodeRedemption[]
  articleViews           ArticleView[]
  readingProgress        ReadingProgress[]
  vocabulary             StudentVocabulary[]
  vocabularyLookups      VocabularyLookup[]
  vocabularyAiActionLogs VocabularyAiActionLog[]
  notificationReads      NotificationRead[]
  trialAuditLogs         TrialAuditLog[]
  writingFeedback        WritingFeedback?
  writingPractice        WritingPractice?
  studyActivities        StudyActivity[]
  studyStreak            StudyStreak?
  achievementUnlocks     AchievementUnlock[]
  writingTaskAssignments WritingTaskAssignment[]
  aiInsightCache         AIInsightCache[]
  questionBookmarks      QuestionBookmark[]
  writingTaskBookmarks   WritingTaskBookmark[]
  invoices               Invoice[]
  premiumRequests        PremiumRequest[]
  fullMockAttempts       FullMockAttempt[]
  articleHighlights      ArticleHighlight[]
  articleNotes           ArticleNote[]
  articleBookmarks       ArticleBookmark[]
  speakingAttempts       SpeakingAttempt[]
  /// Phase 45 — Media Library 2.0.
  readingLibraryBookmarks   ReadingLibraryBookmark[]
  listeningLibraryBookmarks ListeningLibraryBookmark[]

  @@map("student_profiles")
}

model TeacherProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bio       String?
  expertise String?

  /// Phase 17 — Root Teacher. DB-backed admin flag, separate from
  /// ROOT_TEACHER_EMAIL (src/lib/teacher-access.ts), which stays a single
  /// hardcoded bootstrap email used only to decide a brand-new sign-up's
  /// role. This flag is the real "has elevated permissions" check
  /// everywhere else (Students roster, Trial Management, Teacher
  /// Management) — unlike the hardcoded email, more than one teacher can
  /// have it, and it's grantable to an existing account without creating
  /// a new user or touching their existing data.
  isRootTeacher Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students                StudentProfile[]
  mockTests               MockTest[]
  assignments             Assignment[]
  promoCodes              PromoCode[]
  reviewedWritings        WritingSubmission[]   @relation("WritingReviewer")
  reviewedSpeakings       SpeakingSubmission[]  @relation("SpeakingReviewer")
  bandConversionRanges    BandConversionRange[]
  updates                 Update[]
  aiSettings              AiSettings?
  grantedTeacherAccess    TeacherAllowlist[]
  articles                Article[]
  trialAuditLogs          TrialAuditLog[]
  writingTasks            WritingTask[]
  speakingTasks           SpeakingTask[]
  reviewedPremiumRequests PremiumRequest[]      @relation("PremiumRequestReviewer")
  fullMockTests           FullMockTest[]
  speakingTopics          SpeakingTopic[]
  mediaFiles              MediaFile[]
  mediaFolders            MediaFolder[]
  /// Phase 45 — Media Library 2.0.
  readingLibraryItems     ReadingLibraryItem[]
  listeningLibraryItems   ListeningLibraryItem[]
  /// Phase 47 — Skill Media Library's platform-wide cover banners (Root Teacher only — see SkillCoverImage).
  updatedSkillCoverImages SkillCoverImage[]

  @@map("teacher_profiles")
}

// ---------------------------------------------------------------------------
// Test content
// ---------------------------------------------------------------------------

model MockTest {
  id              String              @id @default(cuid())
  title           String
  description     String?             @db.Text
  type            TestType
  /// Phase 20 — Tests Hub grouping for READING/LISTENING tests, and the
  /// platform's one free-without-subscription tier (see hasActiveAccess).
  /// Meaningless for FULL_MOCK, which always defaults to GENERAL and is
  /// never surfaced as "Cambridge".
  category        MockTestCategory    @default(GENERAL)
  isPublished     Boolean             @default(false)
  /// Retired tests stay out of the student-facing catalog but keep their
  /// historical results intact. Independent of isPublished so a test can
  /// never be simultaneously "live" and "archived".
  isArchived      Boolean             @default(false)
  /// Recommended time limit shown before starting and used to drive the
  /// in-exam countdown. Null means untimed.
  durationMinutes Int?
  /// Phase 34 — real, teacher-set difficulty badge (Part 2/3's "Difficulty
  /// badge"). Null for every test created before this phase existed.
  difficulty      MockTestDifficulty?
  /// Phase 47 — Skill Media Library's "Content thumbnails" for Reading/Listening tests. Null until a teacher uploads one.
  coverImagePath  String?

  createdById String
  createdBy   TeacherProfile @relation(fields: [createdById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  passages              Passage[]
  questions             Question[]
  results               Result[]
  assignments           Assignment[]
  fullMockReadingUses   FullMockReadingSection[]
  fullMockListeningUses FullMockListeningSection[]

  @@map("mock_tests")
}

model Passage {
  id         String   @id @default(cuid())
  mockTestId String
  mockTest   MockTest @relation(fields: [mockTestId], references: [id], onDelete: Cascade)

  title         String
  content       String  @db.Text
  /// Legacy: an externally-pasted audio link, from before file upload
  /// existed. Kept only for backward compatibility — the passage editor no
  /// longer writes this field.
  audioUrl      String?
  /// The uploaded audio file's servable path — a relative local path
  /// (`/uploads/...`) in dev, or an absolute public Supabase Storage URL
  /// (bucket "listening-audio") in production, set by the upload flow
  /// (src/lib/uploads/audio-storage.ts). Preferred over `audioUrl` whenever
  /// both are present. `updatedAt` doubles as the upload timestamp — it
  /// bumps whenever this field is written.
  audioPath     String?
  audioFileName String?
  audioMimeType String?
  audioSize     Int?
  orderIndex    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions   Question[]
  highlights  Highlight[]
  notes       Note[]
  /// Phase 35 — real visual materials (images/charts/tables/diagrams/maps)
  /// a teacher attaches to a Reading passage or Listening section, shown
  /// alongside the text/audio in the split-screen exam layout.
  attachments PassageAttachment[]

  @@map("passages")
}

enum PassageAttachmentType {
  IMAGE
  CHART
  TABLE
  DIAGRAM
  MAP
}

/// Phase 35 — Part 4/7. Every real IELTS visual material (a chart, table,
/// diagram or map) is realistically authored as an uploaded image, same as
/// every other digital IELTS platform — not a live-editable table/diagram
/// builder, which would be both fragile and out of scope. `type` is purely
/// a teacher-facing label/icon; rendering is identical for all five.
model PassageAttachment {
  id         String                @id @default(cuid())
  passageId  String
  passage    Passage               @relation(fields: [passageId], references: [id], onDelete: Cascade)
  type       PassageAttachmentType
  imagePath  String
  caption    String?
  orderIndex Int                   @default(0)

  /// Phase 38 — set only when this attachment was picked from the Media
  /// Library rather than uploaded fresh. Null for every pre-Phase-38 row
  /// and for any direct upload — imagePath alone is always enough to
  /// render, this is purely for reuse tracking (MediaUsage).
  mediaFileId String?
  mediaFile   MediaFile? @relation(fields: [mediaFileId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@map("passage_attachments")
}

model Question {
  id         String   @id @default(cuid())
  mockTestId String
  mockTest   MockTest @relation(fields: [mockTestId], references: [id], onDelete: Cascade)
  passageId  String?
  passage    Passage? @relation(fields: [passageId], references: [id], onDelete: Cascade)

  type          QuestionType
  prompt        String       @db.Text
  options       Json?
  correctAnswer Json?
  orderIndex    Int          @default(0)
  points        Int          @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answers               Answer[]
  aiExplanations        AiExplanation[]
  aiExplanationRequests AiExplanationRequest[]
  bookmarks             QuestionBookmark[]

  @@map("questions")
}

/// Phase 24 — "Bookmark difficult questions" (Reading/Listening). Separate
/// from Answer.flaggedQuestionIds (per-attempt, cleared with that attempt) —
/// a bookmark is a durable, cross-test save the student can revisit from the
/// Bookmarked Questions page long after the attempt is gone.
model QuestionBookmark {
  id String @id @default(cuid())

  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([studentId, questionId])
  @@index([studentId])
  @@map("question_bookmarks")
}

// ---------------------------------------------------------------------------
// Attempts & results
// ---------------------------------------------------------------------------

model Result {
  id         String         @id @default(cuid())
  studentId  String
  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  mockTestId String
  mockTest   MockTest       @relation(fields: [mockTestId], references: [id], onDelete: Cascade)

  skill              SkillType
  rawScore           Float?
  bandScore          Float?
  startedAt          DateTime  @default(now())
  completedAt        DateTime?
  /// Wall-clock seconds between startedAt and completedAt, captured once at
  /// submission time so it never needs recomputing.
  durationSeconds    Int?
  /// Question ids the student flagged for review during this attempt.
  flaggedQuestionIds Json      @default("[]")
  /// Phase 41 — the question the student was last viewing, for real
  /// cross-refresh/cross-device "return to exactly where I was" recovery.
  /// Not a foreign key (the question may later be deleted by the teacher) —
  /// just an id the UI falls back past if it no longer resolves.
  lastSeenQuestionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answers               Answer[]
  highlights            Highlight[]
  notes                 Note[]
  /// Phase 34 — set only when this attempt was taken as the Reading or
  /// Listening section of a Full Mock Test, not a standalone attempt.
  fullMockSectionResult FullMockSectionResult?

  @@map("results")
}

model Answer {
  id         String   @id @default(cuid())
  resultId   String
  result     Result   @relation(fields: [resultId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  response      Json
  isCorrect     Boolean?
  pointsAwarded Int?

  createdAt DateTime @default(now())

  @@unique([resultId, questionId])
  @@map("answers")
}

enum HighlightColor {
  YELLOW
  BLUE
  GREEN
}

/// A student's highlighted span of passage text, scoped to one attempt
/// (Result). Reading-only — cleared along with the attempt.
model Highlight {
  id        String  @id @default(cuid())
  resultId  String
  result    Result  @relation(fields: [resultId], references: [id], onDelete: Cascade)
  passageId String
  passage   Passage @relation(fields: [passageId], references: [id], onDelete: Cascade)

  text        String         @db.Text
  startOffset Int
  endOffset   Int
  /// Phase 35 — Part 2's 3-color highlight tool. Defaulted for every
  /// pre-Phase-35 row, which only ever had one implicit color.
  color       HighlightColor @default(YELLOW)

  createdAt DateTime @default(now())

  @@map("highlights")
}

/// A student's free-text scratch note, scoped to one attempt (Result) and
/// optionally to a specific passage.
model Note {
  id        String   @id @default(cuid())
  resultId  String
  result    Result   @relation(fields: [resultId], references: [id], onDelete: Cascade)
  passageId String?
  passage   Passage? @relation(fields: [passageId], references: [id], onDelete: Cascade)

  content String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notes")
}

model WritingSubmission {
  id        String         @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// Kept exactly as-is ("Task 1" / "Task 2") for backward compatibility —
  /// every existing row and read path already relies on these two literal
  /// strings. `category` (Phase 13) is the new, additive subtype dimension.
  taskType  String
  prompt    String @db.Text
  content   String @db.Text
  wordCount Int?

  /// Optional link into the teacher-curated task bank (Phase 13) — null for
  /// a student's own free-typed prompt, exactly like every pre-Phase-13 row.
  taskId   String?
  task     WritingTask?         @relation(fields: [taskId], references: [id], onDelete: SetNull)
  category WritingTaskCategory?

  status SubmissionStatus @default(PENDING)

  bandScore    Float?
  feedback     String?         @db.Text
  /// Phase 42 — Part 15's "Corrections", deliberately separate from the
  /// general `feedback` comments field so a teacher can leave specific
  /// line-level correction notes distinct from overall commentary.
  corrections  String?         @db.Text
  reviewedById String?
  reviewedBy   TeacherProfile? @relation("WritingReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?

  /// Phase 42 — Part 17's basic plagiarism check: set at submission time when
  /// this essay's trimmed content exactly matches another real submission's.
  /// A real, cheap, honest "exact duplicate" signal — never a fuzzy/AI
  /// similarity score, which the spec explicitly didn't ask for.
  isDuplicate Boolean @default(false)

  /// Set the moment a DRAFT becomes a real submission (PENDING). Null for a
  /// still-unsubmitted draft. Existing pre-Phase-13 rows were never drafts,
  /// so this stays null for them too — `status` remains the authoritative
  /// "is this submitted" signal, this is purely a display/analytics timestamp.
  submittedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  analysis              WritingAnalysis?
  rewrites              WritingRewrite[]
  sentenceImprovements  SentenceImprovement[]
  /// Phase 34 — set only when this submission was made as the Writing
  /// section of a Full Mock Test attempt.
  fullMockSectionResult FullMockSectionResult?

  @@map("writing_submissions")
}

// ---------------------------------------------------------------------------
// AI: Writing Checker & Rewriter (Phase 7) / AI Writing Center (Phase 13)
// ---------------------------------------------------------------------------

/// The AI's one-time analysis of a submission. At most one per submission —
/// the essay is immutable once submitted, so re-analyzing the same text
/// would be a wasted, identical OpenAI call; a revised essay is a new
/// WritingSubmission instead.
model WritingAnalysis {
  id           String            @id @default(cuid())
  submissionId String            @unique
  submission   WritingSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  estimatedBand    Float
  /// The 4 official IELTS Writing criteria, scored individually (Phase 13)
  /// — nullable so pre-Phase-13 analyses (which only ever asked the model
  /// for one overall band) don't need fabricated backfill values.
  grammarBand      Float?
  vocabularyBand   Float?
  coherenceBand    Float?
  taskResponseBand Float?

  /// GrammarIssue[] — see src/lib/ai/writing.ts
  grammarIssues Json
  /// VocabularyAnalysis — see src/lib/ai/writing.ts
  vocabulary    Json

  coherenceCohesion String @db.Text
  taskAchievement   String @db.Text
  /// string[], ranked by impact.
  keyImprovements   Json
  /// string[] (Phase 13) — defaults to an empty array for pre-Phase-13 rows, never fabricated.
  strengths         Json   @default("[]")
  /// string[] (Phase 13)
  weaknesses        Json   @default("[]")

  /// The OpenAI model that produced this analysis, kept for audit/debug.
  model String

  createdAt DateTime @default(now())

  @@map("writing_analyses")
}

/// A full rewrite of the essay at a specific target band (7, 8, or 9). At
/// most one per (submission, targetBand) — clicking the same button twice
/// reuses the stored one instead of calling OpenAI again.
model WritingRewrite {
  id           String            @id @default(cuid())
  submissionId String
  submission   WritingSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  targetBand Int
  content    String @db.Text
  notes      String @db.Text

  model String

  createdAt DateTime @default(now())

  @@unique([submissionId, targetBand])
  @@map("writing_rewrites")
}

/// AI feedback on one student-selected sentence. At most one per
/// (submission, sentence) — cached by a hash of the exact sentence text so
/// re-selecting the same sentence never re-calls OpenAI.
model SentenceImprovement {
  id           String            @id @default(cuid())
  submissionId String
  submission   WritingSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  originalSentence String @db.Text
  sentenceHash     String

  weaknessExplanation String @db.Text
  improvedVersion     String @db.Text
  /// string[]
  strongerVocabulary  Json
  structureNote       String @db.Text

  model String

  createdAt DateTime @default(now())

  @@unique([submissionId, sentenceHash])
  @@map("sentence_improvements")
}

/// One row per AI writing action (analysis, rewrite, or sentence
/// improvement) — what the configurable daily rate limit counts against.
/// Cache hits (servedFromCache: true) are logged but don't cost anything, so
/// they don't count against the limit — same pattern as Explain More.
model WritingAiActionLog {
  id String @id @default(cuid())

  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  action          String
  servedFromCache Boolean @default(false)

  createdAt DateTime @default(now())

  @@map("writing_ai_action_logs")
}

// ---------------------------------------------------------------------------
// AI Writing Center (Phase 13)
// ---------------------------------------------------------------------------

/// A teacher-authored Writing Assignment (Architecture Fix — students never
/// create their own writing tasks; every real submission must trace back to
/// one of these, assigned by a teacher to specific students via
/// WritingTaskAssignment below).
model WritingTask {
  id String @id @default(cuid())

  title             String
  /// Phase 42 — Academic vs General Training, a real teacher-chosen field
  /// (both share the same 4 IELTS Writing criteria, so this never changes
  /// grading/AI analysis — it's authoring metadata + student-facing label).
  trainingType      WritingTrainingType @default(ACADEMIC)
  taskNumber        WritingTaskNumber
  category          WritingTaskCategory
  prompt            String              @db.Text
  /// For Task 1 visual tasks (Graph/Table/Process/Map) — a text description
  /// of the chart/diagram/map, kept for tasks authored before real image
  /// upload existed and as an accessible fallback. Null for Task 2.
  visualDescription String?             @db.Text
  /// Phase 42 — Part 11's real uploaded Task 1 visual (chart/graph/table/
  /// map/process image), reusing the Phase 38 Media Library exactly like
  /// PassageAttachment/ArticleAttachment do. Null for Task 2 and for Task 1
  /// tasks still only using the text description above.
  imageMediaFileId String?
  imageMediaFile   MediaFile? @relation(fields: [imageMediaFileId], references: [id], onDelete: SetNull)
  /// Phase 14 — supersedes the old `isPublished` boolean with a real
  /// 3-state lifecycle (Create -> Publish -> Archive), matching the Root
  /// Teacher Writing Tasks workflow. Only PUBLISHED tasks are ever visible
  /// to students, exactly like isPublished: true was before.
  status            WritingTaskStatus   @default(DRAFT)
  /// Optional guidance band this task targets, e.g. 6.5 — shown to students, never used to alter AI scoring.
  targetBand        Float?
  /// The assignment deadline. Purely informational (drives "overdue" styling on the student task list) — never blocks a late submission.
  dueDate           DateTime?
  /// Phase 47 — Skill Media Library's "Content thumbnails" for Writing assignments, shown in task LISTS (distinct from imageMediaFile above, which is the Task 1 question's own chart/graph content).
  coverImagePath    String?

  createdById String
  createdBy   TeacherProfile @relation(fields: [createdById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions WritingSubmission[]
  assignments WritingTaskAssignment[]
  bookmarks   WritingTaskBookmark[]
  /// Phase 34 — set when this task was authored inside the Full Mock Test
  /// builder (Step 4) rather than the general Writing Task bank. Nullable:
  /// every pre-Phase-34 task has none.
  fullMockUse FullMockWritingSection?

  @@index([createdById, status])
  @@map("writing_tasks")
}

/// Phase 24 — Bookmarked Questions page, "Writing" filter tab. Writing has
/// no discrete right/wrong questions, so a bookmark here saves a task prompt
/// to revisit/practice later, not a "difficult question" in the Reading/
/// Listening sense.
model WritingTaskBookmark {
  id String @id @default(cuid())

  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  taskId String
  task   WritingTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([studentId, taskId])
  @@index([studentId])
  @@map("writing_task_bookmarks")
}

/// Architecture Fix — the real enforcement of "Teacher chooses assigned
/// students": a task is only ever visible to (and submittable by) a student
/// with a row here. Replaces the old "PUBLISHED = visible to every student"
/// model with real per-student targeting, set explicitly by the teacher when
/// creating or editing the assignment.
model WritingTaskAssignment {
  id String @id @default(cuid())

  taskId String
  task   WritingTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@unique([taskId, studentId])
  @@index([studentId])
  @@map("writing_task_assignments")
}

/// Phase 14 — Practice Mode. A cached, targeted fill-in-the-blank drill for
/// the student's single weakest recurring area, generated from the same
/// weakest-area signal as WritingFeedback (Phase 13's AI Recommendation) —
/// never a redundant separate weakness-detection pass. One row per student,
/// regenerated only when the weakest area changes or genuinely new analyzed
/// submissions exist since basedOnSubmissionCount was last computed.
model WritingPractice {
  id String @id @default(cuid())

  studentId String         @unique
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  weaknessArea String
  instructions String @db.Text
  /// PracticeItem[] — { sentence: string; answer: string } — see src/lib/ai/prompts/writing-practice.ts
  items        Json

  /// How many analyzed submissions this was computed from — same staleness-detection pattern as WritingFeedback.
  basedOnSubmissionCount Int

  /// The OpenAI model that produced this practice set, kept for audit/debug.
  model String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("writing_practice")
}

/// The "AI Recommendations" widget (Phase 13, section 9) — a cached,
/// periodically-regenerated personalized recommendation, one row per
/// student. Distinct from WritingAnalysis (per-essay): this looks ACROSS a
/// student's real analyzed-submission history to find their weakest
/// recurring area. Regenerated only when there's at least one new analyzed
/// submission since `basedOnSubmissionCount` was last computed — real
/// caching, never a redundant OpenAI call on every dashboard view.
model WritingFeedback {
  id String @id @default(cuid())

  studentId String         @unique
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  weakestArea            String
  recommendation         String @db.Text
  /// How many analyzed submissions this was computed from — lets the next
  /// read detect staleness and regenerate only once real new data exists.
  basedOnSubmissionCount Int

  /// The OpenAI model that produced this recommendation, kept for audit/debug.
  model String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("writing_feedback")
}

/// Phase 20 — teacher-authored Speaking task bank, entered by students via a
/// short unique code (no per-student assignment table, unlike WritingTask —
/// any student with the code can attempt it, matching "student enters using
/// speaking code").
model SpeakingTask {
  id    String @id @default(cuid())
  title String
  /// Short, human-typeable, unique entry code — e.g. "SPK-7F2Q". Students
  /// use this (not a link) to find the task.
  code  String @unique

  part   Int
  prompt String @db.Text

  status SpeakingTaskStatus @default(DRAFT)
  /// Phase 47 — Skill Media Library's "Content thumbnails" for Speaking topics.
  coverImagePath String?

  createdById String
  createdBy   TeacherProfile @relation(fields: [createdById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions SpeakingSubmission[]
  /// Phase 34 — set when this task was authored inside the Full Mock Test
  /// builder (Step 5) rather than the general Speaking Task bank.
  fullMockUse FullMockSpeakingSection?

  @@index([createdById, status])
  @@map("speaking_tasks")
}

model SpeakingSubmission {
  id        String         @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  taskId String
  task   SpeakingTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  /// Denormalized from the task at submit time, so a submission's own record
  /// stays meaningful even if the task is edited or archived later.
  part     Int
  prompt   String  @db.Text
  /// Phase 27 — recordings are never stored (evaluated in-memory, then
  /// discarded — see src/lib/speaking.ts). Always null going forward; kept
  /// nullable (not removed) only so the column doesn't need a destructive
  /// drop for a table that was already empty.
  audioUrl String?

  status SubmissionStatus @default(PENDING)

  /// Phase 27 — AI-evaluated immediately after recording, from a real
  /// Whisper transcript, never a teacher-entered guess. Previously
  /// hidden from the student ("Teacher only") — Phase 27 explicitly
  /// reverses that: the student now sees their AI result immediately, same
  /// as Writing's instant AI feedback. A human teacher's own commentary
  /// layers on top via `teacherNotes`, not by overwriting these.
  bandScore         Float?
  /// The 4 official IELTS Speaking criteria, AI-scored individually (was
  /// teacher-entered in Phase 23; same fields, now real AI output) — this is
  /// what makes a real "Speaking Fluency weakness" pattern possible instead
  /// of inventing one from freeform feedback text.
  fluencyBand       Float?
  lexicalBand       Float?
  grammarBand       Float?
  pronunciationBand Float?
  /// AI-generated overall summary (was teacher-entered pre-Phase-27).
  feedback          String?         @db.Text
  /// string[] — real, AI-identified, grounded in the actual transcript.
  strengths         Json?
  weaknesses        Json?
  /// string[] — concrete next-step suggestions.
  improvements      Json?
  /// Phase 27 — a real, separate, optional human note a teacher adds on top
  /// of the AI result. Distinct from `feedback` (AI-authored) on purpose.
  teacherNotes      String?         @db.Text
  /// When the AI evaluation actually ran — distinct from `createdAt`
  /// (submission time) in case evaluation is ever retried/regenerated.
  evaluatedAt       DateTime?
  reviewedById      String?
  reviewedBy        TeacherProfile? @relation("SpeakingReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Phase 34 — set only when this submission was made as one of the 3
  /// Speaking parts of a Full Mock Test attempt.
  fullMockSectionResult FullMockSectionResult?

  @@index([taskId])
  @@index([studentId])
  @@map("speaking_submissions")
}

// ---------------------------------------------------------------------------
// Speaking Practice Center (Phase 37) — a deliberately SEPARATE, simpler
// practice tool from the audio-recording Speaking system above
// (SpeakingTask/SpeakingSubmission): the student TYPES an answer instead of
// recording audio, and gets AI feedback purely for practice. Never linked
// to Result, never an "official" IELTS score, no teacher grading workflow.
// Route note: the existing /student/speaking (audio + code entry) already
// occupies that path, so this phase's student-facing routes live at
// /student/speaking-practice instead — see the Phase 37 report.
// ---------------------------------------------------------------------------

enum SpeakingPracticePart {
  PART_1
  PART_2
  PART_3
}

enum SpeakingTopicStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model SpeakingTopic {
  id     String               @id @default(cuid())
  title  String
  part   SpeakingPracticePart
  status SpeakingTopicStatus  @default(DRAFT)

  /// Part 2 (Cue Card) only — null for Part 1/3 topics, which instead use child SpeakingQuestion rows.
  cueCardDescription  String? @db.Text
  /// string[]
  cueCardBulletPoints Json?
  cueCardFollowUp     String? @db.Text

  createdById String
  createdBy   TeacherProfile @relation(fields: [createdById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions SpeakingQuestion[]
  attempts  SpeakingAttempt[]

  @@index([createdById, status])
  @@map("speaking_topics")
}

/// Part 1/3 only — one short question or discussion prompt within a topic. Part 2 topics have none (the cue card fields on SpeakingTopic are the whole prompt).
model SpeakingQuestion {
  id      String        @id @default(cuid())
  topicId String
  topic   SpeakingTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  prompt     String @db.Text
  orderIndex Int    @default(0)

  createdAt DateTime @default(now())

  attempts SpeakingAttempt[]

  @@map("speaking_questions")
}

enum SpeakingAttemptStatus {
  DRAFT
  SUBMITTED
}

model SpeakingAttempt {
  id String @id @default(cuid())

  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  topicId String
  topic   SpeakingTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  /// Set for Part 1/3 (which specific question within the topic); null for Part 2 (the topic's own cue card).
  questionId String?
  question   SpeakingQuestion? @relation(fields: [questionId], references: [id], onDelete: SetNull)

  /// Denormalized copy of topic.part at attempt time, so a later topic edit never rewrites history.
  part SpeakingPracticePart

  content   String @db.Text
  wordCount Int    @default(0)

  status SpeakingAttemptStatus @default(DRAFT)

  startedAt   DateTime  @default(now())
  submittedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  feedback SpeakingFeedback?

  @@index([studentId, createdAt])
  @@index([topicId])
  @@map("speaking_attempts")
}

model SpeakingFeedback {
  id String @id @default(cuid())

  attemptId String          @unique
  attempt   SpeakingAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  grammarBand    Float
  vocabularyBand Float
  fluencyBand    Float
  coherenceBand  Float
  structureBand  Float
  overallBand    Float

  grammarFeedback    String @db.Text
  vocabularyFeedback String @db.Text
  fluencyFeedback    String @db.Text
  coherenceFeedback  String @db.Text
  structureFeedback  String @db.Text

  /// string[]
  strengths   Json
  /// string[]
  weaknesses  Json
  /// string[]
  suggestions Json

  createdAt DateTime @default(now())

  @@map("speaking_feedback")
}

// ---------------------------------------------------------------------------
// Full Mock Tests (Phase 34) — a composite Listening→Reading→Writing→Speaking
// exam assembled from the SAME real engines every skill already uses
// standalone. Named `FullMockTest`, not `MockTest`, to avoid colliding with
// the existing MockTest model (Reading/Listening's own exam definition,
// unchanged and still the thing a Reading/Listening section actually reuses).
//
// Design: every section is a thin junction row pointing at real content
// (an existing MockTest for Reading/Listening, a WritingTask/SpeakingTask
// authored in the builder for Writing/Speaking) — no content is ever
// duplicated. A student's real progress reuses the exact same Result /
// WritingSubmission / SpeakingSubmission rows every standalone attempt
// already produces; FullMockSectionResult only links them to the umbrella
// FullMockAttempt so they can be queried together.
// ---------------------------------------------------------------------------

enum FullMockTestStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model FullMockTest {
  id               String             @id @default(cuid())
  title            String
  description      String?            @db.Text
  coverImagePath   String?
  status           FullMockTestStatus @default(DRAFT)
  /// A real, teacher-set guidance range shown on the card (e.g. 6.0-7.5) —
  /// never computed/invented; null until the teacher sets it in Step 1/6.
  estimatedBandMin Float?
  estimatedBandMax Float?
  /// Phase 47 — Mock Exam Center card's "Exam Number" (e.g. "Cambridge Mock 1").
  /// A real teacher-set label, never parsed/guessed from the title.
  examNumber       Int?
  /// Phase 47 — reuses the same enum Reading/Listening MockTests already use,
  /// purely a teacher-set guidance badge (never alters routing/scoring).
  difficulty       MockTestDifficulty?
  /// Phase 47 — reuses the exact CAMBRIDGE-is-free-without-subscription
  /// convention MockTest already has (see hasActiveAccessForTest); a
  /// CAMBRIDGE-category Full Mock Test is the "Free users: limited" tier's
  /// real free inventory, GENERAL is premium-gated. Defaults to GENERAL so
  /// every pre-Phase-47 test stays premium-gated exactly as it already was.
  category         MockTestCategory   @default(GENERAL)

  createdById String
  createdBy   TeacherProfile @relation(fields: [createdById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  readingSections   FullMockReadingSection[]
  listeningSections FullMockListeningSection[]
  writingSections   FullMockWritingSection[]
  speakingSections  FullMockSpeakingSection[]
  attempts          FullMockAttempt[]

  @@map("full_mock_tests")
}

/// Junction only — reuses an existing Reading-type MockTest wholesale
/// (Part 7: "no duplicate content storage"). orderIndex lets a mock combine
/// more than one Reading test, though the builder's default flow selects one.
model FullMockReadingSection {
  id String @id @default(cuid())

  fullMockTestId String
  fullMockTest   FullMockTest @relation(fields: [fullMockTestId], references: [id], onDelete: Cascade)
  mockTestId     String
  mockTest       MockTest     @relation(fields: [mockTestId], references: [id], onDelete: Cascade)

  orderIndex Int @default(0)

  createdAt DateTime @default(now())

  @@unique([fullMockTestId, mockTestId])
  @@map("full_mock_reading_sections")
}

/// Same shape as FullMockReadingSection, for a Listening-type MockTest.
model FullMockListeningSection {
  id String @id @default(cuid())

  fullMockTestId String
  fullMockTest   FullMockTest @relation(fields: [fullMockTestId], references: [id], onDelete: Cascade)
  mockTestId     String
  mockTest       MockTest     @relation(fields: [mockTestId], references: [id], onDelete: Cascade)

  orderIndex Int @default(0)

  createdAt DateTime @default(now())

  @@unique([fullMockTestId, mockTestId])
  @@map("full_mock_listening_sections")
}

/// Junction to a real WritingTask the builder created (Step 4) — Task 1 and
/// Task 2 are 2 rows, ordered. The WritingTask itself carries the real
/// prompt/instructions; nothing is duplicated here.
model FullMockWritingSection {
  id String @id @default(cuid())

  fullMockTestId String
  fullMockTest   FullMockTest @relation(fields: [fullMockTestId], references: [id], onDelete: Cascade)
  writingTaskId  String       @unique
  writingTask    WritingTask  @relation(fields: [writingTaskId], references: [id], onDelete: Cascade)

  orderIndex Int @default(0)

  createdAt DateTime @default(now())

  @@map("full_mock_writing_sections")
}

/// Junction to a real SpeakingTask the builder created (Step 5) — Part 1/2/3
/// are 3 rows, ordered. Same no-duplication reasoning as Writing above.
model FullMockSpeakingSection {
  id String @id @default(cuid())

  fullMockTestId String
  fullMockTest   FullMockTest @relation(fields: [fullMockTestId], references: [id], onDelete: Cascade)
  speakingTaskId String       @unique
  speakingTask   SpeakingTask @relation(fields: [speakingTaskId], references: [id], onDelete: Cascade)

  orderIndex Int @default(0)

  createdAt DateTime @default(now())

  @@map("full_mock_speaking_sections")
}

enum FullMockSectionType {
  LISTENING
  READING
  WRITING
  SPEAKING
}

enum FullMockAttemptStatus {
  IN_PROGRESS
  COMPLETED
}

/// One row per student per real sitting of a Full Mock Test — Part 8's
/// "auto progression" state machine lives here (`currentSection`), and
/// Part 9's results are assembled by joining `sectionResults`' real,
/// already-scored underlying rows, never recomputed or invented here.
model FullMockAttempt {
  id String @id @default(cuid())

  fullMockTestId String
  fullMockTest   FullMockTest   @relation(fields: [fullMockTestId], references: [id], onDelete: Cascade)
  studentId      String
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  status         FullMockAttemptStatus @default(IN_PROGRESS)
  /// The section the student should be routed to next. Always advances
  /// Listening -> Reading -> Writing -> Speaking, never backward.
  currentSection FullMockSectionType   @default(LISTENING)

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  sectionResults FullMockSectionResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([fullMockTestId])
  @@map("full_mock_attempts")
}

/// Links ONE real completed Result / WritingSubmission / SpeakingSubmission
/// row to its FullMockAttempt — exactly one of the 3 optional FKs is set,
/// matching `section`. `partNumber` distinguishes Writing's 2 tasks and
/// Speaking's 3 parts (null for Reading/Listening, which are single-shot).
model FullMockSectionResult {
  id String @id @default(cuid())

  attemptId  String
  attempt    FullMockAttempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  section    FullMockSectionType
  partNumber Int?

  resultId String? @unique
  result   Result? @relation(fields: [resultId], references: [id], onDelete: SetNull)

  writingSubmissionId String?            @unique
  writingSubmission   WritingSubmission? @relation(fields: [writingSubmissionId], references: [id], onDelete: SetNull)

  speakingSubmissionId String?             @unique
  speakingSubmission   SpeakingSubmission? @relation(fields: [speakingSubmissionId], references: [id], onDelete: SetNull)

  completedAt DateTime @default(now())

  @@index([attemptId])
  @@map("full_mock_section_results")
}

enum AIInsightKind {
  MISTAKE_ANALYSIS
  IMPROVEMENT_PLAN
  TEACHER_REPORT
  MOTIVATION_MESSAGE
}

/**
 * Phase 23 — "Store analysis efficiently. Generate on demand." One row per
 * (student, kind): a regenerate overwrites it (upsert), rather than piling
 * up history — this is a cache of the latest AI read on real performance
 * data, not an audit log. `content` shape depends on `kind`; each reader
 * knows its own shape (see src/lib/ai/insight-cache.ts).
 */
model AIInsightCache {
  id String @id @default(cuid())

  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  kind    AIInsightKind
  content Json

  generatedAt DateTime @default(now())

  @@unique([studentId, kind])
  @@map("ai_insight_cache")
}

// ---------------------------------------------------------------------------
// Teaching workflow
// ---------------------------------------------------------------------------

model Assignment {
  id         String         @id @default(cuid())
  teacherId  String
  teacher    TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  studentId  String
  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  mockTestId String?
  mockTest   MockTest?      @relation(fields: [mockTestId], references: [id], onDelete: SetNull)

  title   String
  notes   String?          @db.Text
  status  AssignmentStatus @default(ASSIGNED)
  dueDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("assignments")
}

// ---------------------------------------------------------------------------
// Billing
// ---------------------------------------------------------------------------

model SubscriptionPlan {
  id          String          @id @default(cuid())
  name        String
  description String?
  price       Float
  currency    String          @default("USD")
  interval    BillingInterval
  features    Json?
  isActive    Boolean         @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
  invoices      Invoice[]

  @@map("subscription_plans")
}

model Subscription {
  id        String            @id @default(cuid())
  studentId String
  student   StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// Null for a free trial — a trial isn't tied to any priced plan. Only
  /// set once a student is actually on a real paid SubscriptionPlan.
  planId    String?
  plan      SubscriptionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  status    SubscriptionStatus @default(TRIAL)
  startDate DateTime           @default(now())
  endDate   DateTime?
  /// Phase 26 — how this student most recently became/stayed ACTIVE. Null
  /// for an organic trial; set (and never cleared) by
  /// redeemPremiumWithCoins/grantPremium/a completed direct Payment.
  source    PremiumSource?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]

  @@map("subscriptions")
}

enum PremiumRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Phase 30 — the 3 fixed Telegram-sales plans. Deliberately not tied to the
/// existing, teacher-configurable SubscriptionPlan model: these 3 have
/// fixed prices/durations dictated by the phase spec, not per-teacher
/// customization.
enum PremiumPlanCode {
  ONE_MONTH
  THREE_MONTHS
  SIX_MONTHS
  /// Phase 43 — the 4th real duration tier (Monthly/3/6/12 months).
  TWELVE_MONTHS
}

/// Phase 30 — Telegram Premium Sales. A student "buying" Premium creates one
/// of these (PENDING) and is redirected to Telegram with a prefilled
/// message; there is no payment gateway, so this row IS the purchase
/// record until a root teacher manually approves or rejects it — see
/// src/lib/premium-requests.ts.
model PremiumRequest {
  id String @id @default(cuid())

  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  planCode     PremiumPlanCode
  /// Denormalized snapshot of the plan's price/duration at request time, so
  /// a later change to PREMIUM_PLANS never rewrites what an already-submitted
  /// request actually asked for.
  priceLabel   String
  durationDays Int

  status PremiumRequestStatus @default(PENDING)

  reviewedById String?
  reviewedBy   TeacherProfile? @relation("PremiumRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([status])
  @@map("premium_requests")
}

model PromoCode {
  id             String        @id @default(cuid())
  /// Always system-generated, always "AZ" + 6 random uppercase
  /// letters/digits — enforced in app code (src/lib/promo-codes.ts) and by
  /// a CHECK constraint at the database level (see migration).
  code           String        @unique
  type           PromoCodeType
  /// The discount percentage for PERCENTAGE codes (the only type this
  /// phase's UI creates — FIXED_AMOUNT remains schema-supported but unused).
  value          Float
  /// Extra trial days granted on redemption. 0 means "discount only".
  bonusTrialDays Int           @default(0)
  maxUses        Int?
  usedCount      Int           @default(0)
  expiresAt      DateTime?
  isActive       Boolean       @default(true)

  createdById String
  createdBy   TeacherProfile @relation(fields: [createdById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments    Payment[]
  redemptions PromoCodeRedemption[]

  @@map("promo_codes")
}

/// One row per (promoCode, student) redemption — the real record of "who
/// redeemed what, and what they actually got," and what usedCount/analytics
/// are computed from. The unique constraint is the real enforcement of
/// "a student can't redeem the same code twice."
model PromoCodeRedemption {
  id          String         @id @default(cuid())
  promoCodeId String
  promoCode   PromoCode      @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// Snapshots of the promo code's terms at redemption time, so this row
  /// stays meaningful even if the code is edited or deleted later.
  discountPercent Float?
  bonusTrialDays  Int    @default(0)

  redeemedAt DateTime @default(now())

  @@unique([promoCodeId, studentId])
  @@map("promo_code_redemptions")
}

model Payment {
  id             String         @id @default(cuid())
  studentId      String
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription?  @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  promoCodeId    String?
  promoCode      PromoCode?     @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)

  amount            Float
  currency          String           @default("USD")
  status            PaymentStatus    @default(PENDING)
  /// Legacy free-text provider name, kept as-is (nothing currently writes
  /// it). Phase 26's typed Payment Provider Layer uses `providerType`
  /// instead — see src/lib/payments/.
  provider          String?
  providerPaymentId String?
  /// Phase 26 — which real provider this payment is/would be processed
  /// through. Null until a real gateway is actually connected.
  providerType      PaymentProvider?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice Invoice?

  @@map("payments")
}

/// Phase 26 — Payment Architecture's Invoice System: a real, durable record
/// of what a student was charged for, independent of whether a payment
/// gateway ever actually processed it (an invoice can exist in DRAFT/
/// PENDING before any real payment attempt). Not connected to a gateway —
/// see src/lib/payments/.
model Invoice {
  id String @id @default(cuid())

  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  paymentId String?  @unique
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  planId String?
  plan   SubscriptionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  amount      Float
  currency    String        @default("USD")
  status      PaymentStatus @default(PENDING)
  description String

  issuedAt DateTime  @default(now())
  dueAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@map("invoices")
}

// ---------------------------------------------------------------------------
// Analytics: band conversion, updates
// ---------------------------------------------------------------------------

/// A teacher-maintained raw-score → band lookup range, e.g. "23-26 -> 6.0".
/// Scoped per teacher (via the test's author) so each teacher can tune their
/// own tests' conversion scale. This is a plain lookup table, not a formula
/// or model — "score conversion, not AI estimation".
model BandConversionRange {
  id       String    @id @default(cuid())
  skill    SkillType
  minScore Int
  maxScore Int
  band     Float

  createdById String
  createdBy   TeacherProfile @relation(fields: [createdById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([createdById, skill, minScore, maxScore])
  @@map("band_conversion_ranges")
}

enum UpdateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// A "What's New" post. Students only ever see PUBLISHED updates from their
/// own teacher.
model Update {
  id          String       @id @default(cuid())
  title       String
  content     String       @db.Text
  status      UpdateStatus @default(DRAFT)
  publishedAt DateTime?

  createdById String
  createdBy   TeacherProfile @relation(fields: [createdById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("updates")
}

/// Phase 20 — per-student read state for teacher-created Updates ("Teacher
/// creates notifications... Student can mark as read"). A row's presence
/// means read; absence means unread — no boolean to keep in sync.
/**
 * Phase 24 — Notification Center V2. Generalized from a strict Update FK to
 * a stable string key so ONE read-state mechanism can span every real
 * notification source (teacher updates, new articles, writing/speaking
 * reviews, system notices) instead of one per source table — see
 * src/lib/notifications.ts for the key scheme (matches WhatsNewItem's).
 */
model NotificationRead {
  id String @id @default(cuid())

  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  itemKey String

  readAt DateTime @default(now())

  @@unique([studentId, itemKey])
  @@index([studentId])
  @@map("notification_reads")
}

// ---------------------------------------------------------------------------
// AI: Explain More (Phase 5) — the first OpenAI-powered feature. Server-side
// only; nothing here is ever reachable from the browser except through the
// Server Action that fronts it.
// ---------------------------------------------------------------------------

/// A generated explanation for one question + one specific student response,
/// cached so identical requests never call OpenAI twice — whether that's the
/// same student reopening the review page or a different student who made
/// the exact same mistake on the same question.
model AiExplanation {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  /// SHA-256 of the normalized student response this explanation was
  /// generated for — the cache key together with questionId.
  responseHash String

  whyCorrectExplanation   String @db.Text
  whyIncorrectExplanation String @db.Text
  keywordEvidence         String @db.Text
  examStrategy            String @db.Text
  similarMistakeWarning   String @db.Text

  /// The OpenAI model that produced this explanation, kept for audit/debug.
  model String

  createdAt DateTime @default(now())

  requests AiExplanationRequest[]

  @@unique([questionId, responseHash])
  @@map("ai_explanations")
}

/// One row per "Explain More" click — the real request history (which
/// student, which question, when), regardless of whether it was served from
/// cache or freshly generated. This is what daily rate limiting counts
/// against and what teacher analytics ("most requested explanations")
/// aggregates.
model AiExplanationRequest {
  id String @id @default(cuid())

  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  explanationId String
  explanation   AiExplanation @relation(fields: [explanationId], references: [id], onDelete: Cascade)

  /// True when this request reused a cached AiExplanation rather than calling
  /// OpenAI. Cache hits are logged for history/analytics but don't cost
  /// anything, so they don't count against the daily rate limit.
  servedFromCache Boolean @default(false)

  createdAt DateTime @default(now())

  @@map("ai_explanation_requests")
}

/// A generated personalized study plan snapshot (Phase 6 — AI Study Coach).
/// Grounded in real analytics captured at generation time; never
/// regenerated silently — the student explicitly asks for a new one, so
/// each row is a real, distinct snapshot in the student's history.
model StudyPlan {
  id        String         @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// Snapshots of the real numbers the plan was generated from, so a past
  /// plan still makes sense to read even after later attempts change them.
  estimatedBand Float?
  targetBand    Float?

  summary    String @db.Text
  /// StudyPlanDay[] — see src/lib/ai/study-coach.ts
  weeklyPlan Json
  /// RoadmapMilestone[] — see src/lib/ai/study-coach.ts
  roadmap    Json

  /// The OpenAI model that produced this plan, kept for audit/debug.
  model String

  createdAt DateTime @default(now())

  @@map("study_plans")
}

/// Per-teacher configurable AI settings. One row per teacher, created on
/// first edit — a missing row just means "use the default."
model AiSettings {
  id String @id @default(cuid())

  teacherId String         @unique
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  /// "Explain More" requests a single student can generate fresh per day.
  dailyExplanationLimit        Int @default(20)
  /// AI writing actions (analysis, rewrite, or sentence improvement) a
  /// single student can generate fresh per day.
  dailyWritingActionLimit      Int @default(10)
  /// Fresh AI Vocabulary Assistant generations (word intelligence + Explain
  /// Word combined) a single student can trigger per day. Cache hits never
  /// count against this.
  dailyVocabularyAiLimit       Int @default(50)
  /// Phase 26 — Study Coin Rewards' configurable daily cap (coins, not
  /// requests) — see src/lib/coins.ts settleStudyCoinsForToday. Same
  /// per-teacher-configurable pattern as the 3 limits above.
  dailyStudyCoinCap            Int @default(45)
  /// Phase 27 — real-time AI Speaking evaluations (Whisper transcription +
  /// scoring) a single student can trigger per day — see
  /// src/lib/speaking.ts assertWithinSpeakingRateLimit. Counted directly
  /// from SpeakingSubmission rows created today, no separate log table.
  dailySpeakingEvaluationLimit Int @default(15)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ai_settings")
}

// ---------------------------------------------------------------------------
// Teacher access control
// ---------------------------------------------------------------------------

/// Database-backed authorization list for who is allowed to become/be a
/// TEACHER — the only role-granting mechanism besides the single hardcoded
/// root admin email (see src/lib/teacher-access.ts). Never a hardcoded
/// array in code; managed entirely through the Teacher Management page.
model TeacherAllowlist {
  id    String @id @default(cuid())
  email String @unique

  addedById String
  addedBy   TeacherProfile @relation(fields: [addedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("teacher_allowlist")
}

// ---------------------------------------------------------------------------
// Trial Management (Bonus feature) — root-teacher-only trial reset/extend
// ---------------------------------------------------------------------------

enum TrialAuditAction {
  TRIAL_RESET_90
  TRIAL_EXTEND_30
  /// Phase 26 — Admin Premium Control, logged into this same audit trail
  /// rather than a parallel table (it's the same "root teacher changed a
  /// student's subscription state" event, just a different real reason).
  PREMIUM_GRANT
  PREMIUM_REMOVE
  /// Phase 30 — Telegram Premium Sales: a root teacher approving/rejecting
  /// a student's PremiumRequest, logged into this same real audit trail.
  PREMIUM_TELEGRAM_APPROVE
  PREMIUM_TELEGRAM_REJECT
  /// Phase 43 — a real, distinct "Cancel Subscription" admin action (status
  /// -> CANCELLED), separate from PREMIUM_REMOVE (status -> EXPIRED, used
  /// for "ended/lapsed" access) so Premium Analytics and the Subscription
  /// Management table can tell a deliberate cancellation from a natural expiry.
  PREMIUM_CANCEL
}

/// One row per root-teacher trial action — created once, never updated or
/// deleted (no delete/deleteMany call for this model exists anywhere in the
/// codebase; this is the real enforcement of "audit logs must never be
/// deleted"). Both FKs are nullable with onDelete: SetNull specifically so
/// the audit ROW itself always survives even if the student or root
/// account it references is ever removed — the row is the permanent
/// record, not a live reference.
model TrialAuditLog {
  id String @id @default(cuid())

  rootTeacherId String?
  rootTeacher   TeacherProfile? @relation(fields: [rootTeacherId], references: [id], onDelete: SetNull)
  studentId     String?
  student       StudentProfile? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  action             TrialAuditAction
  previousExpiryDate DateTime?
  newExpiryDate      DateTime

  createdAt DateTime @default(now())

  @@index([studentId])
  @@index([createdAt])
  @@map("trial_audit_logs")
}

// ---------------------------------------------------------------------------
// Articles & Vocabulary (Phase 11)
// ---------------------------------------------------------------------------

/// A teacher-authored reading article. `content` is long-form text (paragraph
/// breaks preserved on render) — the same plain-text-not-HTML convention
/// already used for `Passage.content`, chosen here specifically because the
/// reader needs to tokenize every individual word for the highlight/lookup
/// feature, which a stored HTML tree would make far harder to do safely.
model Article {
  id             String            @id @default(cuid())
  title          String
  description    String?           @db.Text
  content        String            @db.Text
  coverImagePath String?
  category       String
  difficulty     ArticleDifficulty
  status         ArticleStatus     @default(DRAFT)
  publishedAt    DateTime?

  /// Derived from `content` at save time (word count / 200wpm) — a real,
  /// deterministic computation, not an estimate typed in by the teacher.
  wordCount      Int
  readingMinutes Int

  /// Phase 17 — Article Audio. Both null for every article created before
  /// this existed and for any article a teacher never attaches audio to;
  /// the student page hides the audio player entirely when audioUrl is
  /// null, so this is fully backward compatible. audioDuration is seconds,
  /// read from the uploaded file's real metadata at upload time — never
  /// estimated.
  audioUrl      String?
  audioDuration Int?

  /// Phase 36 — Part 11. string[] of ArticleSkillTag values (see
  /// src/lib/articles-skill-tags.ts) — Json rather than a native Postgres
  /// array, same convention as Result.flaggedQuestionIds, so the tag set
  /// can evolve without a migration. Empty array for every pre-Phase-36
  /// article and any article a teacher hasn't tagged.
  skillTags Json @default("[]")

  createdById String
  createdBy   TeacherProfile @relation(fields: [createdById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  views             ArticleView[]
  readingProgress   ReadingProgress[]
  vocabularyEvents  StudentVocabulary[]
  vocabularyLookups VocabularyLookup[]
  /// Phase 36 — Part 3/6/8.
  highlights        ArticleHighlight[]
  notes             ArticleNote[]
  bookmarks         ArticleBookmark[]
  /// Phase 38 — inline images/infographics/attachments (Part 5).
  attachments       ArticleAttachment[]

  @@index([createdById, status])
  @@map("articles")
}

/// Phase 36 — Part 3. A student's persistent (not attempt-scoped, unlike
/// the exam Reading/Listening Highlight model) highlighted span of article
/// text, in one of 3 purpose-colors — reuses the same HighlightColor enum
/// Phase 35 introduced for exam passages, remapped here to Important
/// (yellow) / New Vocabulary (blue) / Review Later (green).
model ArticleHighlight {
  id        String         @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  articleId String
  article   Article        @relation(fields: [articleId], references: [id], onDelete: Cascade)

  text        String         @db.Text
  startOffset Int
  endOffset   Int
  color       HighlightColor @default(YELLOW)

  createdAt DateTime @default(now())

  @@index([studentId, articleId])
  @@map("article_highlights")
}

/// Phase 36 — Part 4/6. General reading notes (observations, IELTS tips) a
/// student attaches to an article — also what "Add Note" on a selected
/// word writes into, prefixed with the word/quote, same UX convention as
/// the exam Notes drawer.
model ArticleNote {
  id        String         @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  articleId String
  article   Article        @relation(fields: [articleId], references: [id], onDelete: Cascade)

  content String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId, articleId])
  @@map("article_notes")
}

/// Phase 36 — Part 8. "Bookmark article, resume later" — same shape/convention as QuestionBookmark and WritingTaskBookmark.
model ArticleBookmark {
  id        String         @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  articleId String
  article   Article        @relation(fields: [articleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([studentId, articleId])
  @@index([studentId])
  @@map("article_bookmarks")
}

// ---------------------------------------------------------------------------
// Phase 45 — Media Library 2.0 + IELTS Content Management System
// Feature 1: Reading Library (real uploaded PDFs — distinct from Article,
// which is interactive plain-text content; this is browsable, downloadable
// reference/practice material). Feature 2: Listening Library (real uploaded
// standalone audio, distinct from Listening MockTest passages, which are
// timed/graded exam content). Both reuse ArticleDifficulty/ArticleStatus
// rather than duplicating near-identical enums.
// ---------------------------------------------------------------------------

model ReadingLibraryItem {
  id             String            @id @default(cuid())
  title          String
  description    String?           @db.Text
  category       String
  level          ArticleDifficulty
  /// Teacher-set guidance band, e.g. 6.5 — shown to students, never used to alter any real scoring.
  estimatedBand  Float?
  /// Real teacher-provided word count (a PDF's content can't be reliably auto-extracted the way Article.content's plain text can) — readingMinutes is then a real deterministic computation from it (word count / 200wpm), same formula Article uses. Both null until the teacher provides a word count.
  wordCount      Int?
  readingMinutes Int?

  pdfPath        String
  pdfFileName    String
  pdfSize        Int
  coverImagePath String?

  status      ArticleStatus @default(DRAFT)
  publishedAt DateTime?

  createdById String
  createdBy   TeacherProfile @relation(fields: [createdById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookmarks ReadingLibraryBookmark[]

  @@index([createdById, status])
  @@map("reading_library_items")
}

model ReadingLibraryBookmark {
  id        String             @id @default(cuid())
  studentId String
  student   StudentProfile     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  itemId    String
  item      ReadingLibraryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([studentId, itemId])
  @@index([studentId])
  @@map("reading_library_bookmarks")
}

enum ListeningAccent {
  BRITISH
  AMERICAN
  AUSTRALIAN
  CANADIAN
}

model ListeningLibraryItem {
  id          String            @id @default(cuid())
  title       String
  description String?           @db.Text
  level       ArticleDifficulty
  accent      ListeningAccent

  audioPath            String
  audioFileName        String
  audioSize            Int
  /// Seconds, read from the real uploaded file's own metadata client-side at upload time — never estimated, same convention as Article.audioDuration.
  audioDurationSeconds Int?
  /// Presence of real transcript text is what "view transcript availability" checks — never a boolean flag that could drift from the real data.
  transcript           String? @db.Text
  coverImagePath       String?

  status      ArticleStatus @default(DRAFT)
  publishedAt DateTime?

  createdById String
  createdBy   TeacherProfile @relation(fields: [createdById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookmarks ListeningLibraryBookmark[]

  @@index([createdById, status])
  @@map("listening_library_items")
}

model ListeningLibraryBookmark {
  id        String               @id @default(cuid())
  studentId String
  student   StudentProfile       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  itemId    String
  item      ListeningLibraryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([studentId, itemId])
  @@index([studentId])
  @@map("listening_library_bookmarks")
}

/// One row per article open by a student — a real view event, not a
/// counter. "Total views" sums these rows; "Total readers" counts distinct
/// students among them.
model ArticleView {
  id        String         @id @default(cuid())
  articleId String
  article   Article        @relation(fields: [articleId], references: [id], onDelete: Cascade)
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  viewedAt DateTime @default(now())

  @@index([articleId])
  @@index([studentId])
  @@map("article_views")
}

/// A shared dictionary entry for one normalized English word. Left empty
/// (translation/definition/example all null) until something actually
/// populates it — today that's nothing (see src/lib/ai/word-assistant.ts,
/// architecture only, no OpenAI calls yet), so a freshly-clicked word
/// honestly shows "not available yet" rather than an invented definition.
/// One row is shared by every student who looks the word up.
model VocabularyWord {
  id   String @id @default(cuid())
  /// Lowercased and trimmed — the lookup key, so "Resume" and "resume" share one entry.
  word String @unique

  uzbekTranslation  String?
  englishDefinition String? @db.Text
  exampleSentence   String? @db.Text

  /// Phase 12.3 — AI Vocabulary Assistant. Generated once, by the AI Word
  /// Assistant (src/lib/ai/vocabulary-assistant.ts), the first time any
  /// student opens this word's details — shared by every student who has
  /// it saved, exactly like the fields above. `aiGeneratedAt` null means
  /// none of this has been generated yet; it's never partially filled.
  /// string[]
  synonyms         Json?
  /// string[] — genuinely empty for words with no natural opposite, never a fabricated one.
  opposites        Json?
  /// string[]
  relatedWords     Json?
  /// { form: string; word: string }[] — e.g. [{form:"noun",word:"achievement"}, ...]
  wordFamily       Json?
  ipaPronunciation String?
  stressPattern    String?
  /// string[3]
  simpleExamples   Json?
  /// string[2]
  ieltsExamples    Json?
  ieltsDifficulty  ArticleDifficulty?
  /// The OpenAI model that produced the fields above, kept for audit/debug.
  aiModel          String?
  aiGeneratedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentEntries StudentVocabulary[]
  lookups        VocabularyLookup[]
  explanation    AiWordExplanation?
  aiActionLogs   VocabularyAiActionLog[]

  @@map("vocabulary_words")
}

/// The "Explain Word" deep-dive (Phase 12.3) — meaning/usage/common
/// mistakes/when-to-use/when-not-to-use. One per word, shared across every
/// student, generated on-demand the first time any student clicks
/// "Explain Word" — same cache-once-reuse-forever philosophy as the
/// VocabularyWord fields above and as AiExplanation elsewhere in this app.
model AiWordExplanation {
  id               String         @id @default(cuid())
  vocabularyWordId String         @unique
  vocabularyWord   VocabularyWord @relation(fields: [vocabularyWordId], references: [id], onDelete: Cascade)

  meaning        String @db.Text
  usage          String @db.Text
  commonMistakes String @db.Text
  whenToUse      String @db.Text
  whenNotToUse   String @db.Text

  /// The OpenAI model that produced this explanation, kept for audit/debug.
  model     String
  createdAt DateTime @default(now())

  @@map("ai_word_explanations")
}

enum VocabularyAiAction {
  WORD_INTELLIGENCE
  EXPLAIN_WORD
}

/// One row per AI Vocabulary Assistant request — what the daily rate limit
/// counts against (servedFromCache: false only) and the real data source
/// for /student/vocabulary/history ("last viewed" = WORD_INTELLIGENCE rows,
/// "recently explained" = EXPLAIN_WORD rows). Cache hits are logged too —
/// they're real activity, they just don't cost anything or count against
/// the quota — same pattern as AiExplanationRequest.
model VocabularyAiActionLog {
  id String @id @default(cuid())

  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  vocabularyWordId String?
  vocabularyWord   VocabularyWord?    @relation(fields: [vocabularyWordId], references: [id], onDelete: SetNull)
  action           VocabularyAiAction
  servedFromCache  Boolean            @default(false)

  createdAt DateTime @default(now())

  @@index([studentId, createdAt])
  @@map("vocabulary_ai_action_logs")
}

/// One row per (student, word) — the permanent record of every word a
/// student has ever tagged Unknown/Learning/Known, across every article.
/// This is what the personal vocabulary book, review and future
/// AI-powered tools are built on. The unique constraint is the real
/// enforcement of "no duplicate words per student."
model StudentVocabulary {
  id        String         @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  vocabularyWordId String
  vocabularyWord   VocabularyWord @relation(fields: [vocabularyWordId], references: [id], onDelete: Cascade)

  /// The article this word was first tagged in — kept for context only.
  /// Nullable/SetNull because the word entry itself must outlive the
  /// article (an unpublished/deleted article shouldn't erase a student's
  /// vocabulary progress).
  articleId String?
  article   Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)

  status VocabularyStatus @default(UNKNOWN)

  addedAt        DateTime @default(now())
  lastReviewedAt DateTime @default(now())

  @@unique([studentId, vocabularyWordId])
  @@index([studentId, status])
  @@map("student_vocabulary")
}

/// Phase 19 — Vocabulary Intelligence. An append-only log, one row per word
/// click/lookup — deliberately NOT deduplicated, unlike StudentVocabulary
/// above (one row per unique word, current status only). This is what lets
/// "Total Searches" (every click, including repeats) differ from "Unique
/// Words" (StudentVocabulary's row count) in the analytics this powers.
/// Written alongside StudentVocabulary, never instead of it — the existing
/// vocabulary popup/notebook keep reading/writing StudentVocabulary exactly
/// as before.
model VocabularyLookup {
  id        String         @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  vocabularyWordId String
  vocabularyWord   VocabularyWord @relation(fields: [vocabularyWordId], references: [id], onDelete: Cascade)

  articleId String?
  article   Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)

  /// Red = Hard (UNKNOWN) / Yellow = Medium (LEARNING) / Blue = Easy
  /// (KNOWN) — the student's current classification at the moment of this
  /// click, defaulting to Medium when no color has ever been chosen.
  difficultyColor VocabularyStatus

  createdAt DateTime @default(now())

  @@index([studentId, createdAt])
  @@index([articleId])
  @@index([vocabularyWordId])
  @@map("vocabulary_lookups")
}

/// "Continue where they stopped" — one row per (student, article), upserted
/// as the student scrolls. `lastPosition` is a 0-based character offset
/// into `Article.content`.
model ReadingProgress {
  id        String         @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  articleId String
  article   Article        @relation(fields: [articleId], references: [id], onDelete: Cascade)

  lastPosition    Int       @default(0)
  percentComplete Int       @default(0)
  completedAt     DateTime?

  /// Phase 17 — Article Audio. audioProgress is 0-100, the same shape as
  /// percentComplete but tracking the audio player's furthest position
  /// instead of scroll position; stays 0 for articles with no audio.
  /// timeSpentSeconds accumulates real elapsed time with the article open
  /// (reading or listening) — never a fabricated estimate. lastOpenedAt
  /// updates alongside progress, which in practice tracks "last opened"
  /// closely enough without a dedicated page-view write on every visit.
  audioProgress    Int      @default(0)
  timeSpentSeconds Int      @default(0)
  lastOpenedAt     DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, articleId])
  @@map("reading_progress")
}

// ---------------------------------------------------------------------------
// Student Profile, Goals, Coins & Rewards (Phase 15)
// ---------------------------------------------------------------------------

/// One row per (student, activity type, calendar day). Heartbeat pings
/// (Vocabulary/Writing/Article — src/lib/study-activity.ts) and the real
/// exam-attempt duration (Reading/Listening, hooked from
/// src/lib/exam/attempts.ts submitAttempt) both add real, server-computed
/// seconds here — never a client-supplied duration. The single source of
/// truth "today's / weekly / monthly study time" and the coin economy are
/// both computed from.
model StudyActivity {
  id String @id @default(cuid())

  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  type            StudyActivityType
  /// Truncated to local midnight — the calendar day this row belongs to.
  activityDate    DateTime
  durationSeconds Int               @default(0)
  /// The server timestamp of the last heartbeat — the anchor the NEXT
  /// heartbeat's real elapsed-time credit is computed from. Stays null for
  /// Reading/Listening rows (those are written once, from a real completed
  /// Result's own durationSeconds, never via heartbeat).
  lastHeartbeatAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, type, activityDate])
  @@index([studentId, activityDate])
  @@map("study_activities")
}

/// Consecutive-day study streak. A day only counts once real StudyActivity
/// crosses a minimum genuine-engagement threshold (see
/// MIN_DAILY_SECONDS_FOR_STREAK in src/lib/streaks.ts) — never just "any page view".
model StudyStreak {
  id String @id @default(cuid())

  studentId String         @unique
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  /// The last calendar day (truncated) that counted toward the streak.
  lastActiveDate DateTime?

  /// Phase 39 — Part 6. Premium Streak Freeze: set the first time a Premium
  /// student's freeze saves a missed day, so it can never fire twice. Null
  /// means the freeze is still available (every free student too, though
  /// free students never actually consume one — see settleStreakForToday).
  streakFreezeUsedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("study_streaks")
}

/// The fixed catalog of system achievements — seeded once (idempotent
/// upsert-by-code in src/lib/achievements.ts), never student-created. Real
/// unlock conditions are checked against real counts; nothing here is ever
/// awarded speculatively.
model Achievement {
  id String @id @default(cuid())

  code        AchievementCode @unique
  title       String
  description String

  createdAt DateTime @default(now())

  unlocks AchievementUnlock[]

  @@map("achievements")
}

/// One row per (student, achievement) ever unlocked — the permanent
/// achievement history. The unique constraint is the real enforcement of
/// "never award the same achievement twice".
model AchievementUnlock {
  id String @id @default(cuid())

  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  unlockedAt DateTime @default(now())

  @@unique([studentId, achievementId])
  @@map("achievement_unlocks")
}

// ---------------------------------------------------------------------------
// Media Library (Phase 38) — a central, reusable file store sitting on top
// of the SAME storage abstraction every upload already used
// (src/lib/uploads/storage.ts's uploadBuffer, Supabase-backed today,
// swappable to S3/R2 later without touching call sites). Existing
// per-feature attachments (PassageAttachment from Phase 35) keep working
// completely unchanged — MediaFile is additive, linked in via new optional
// fields, never a replacement.
// ---------------------------------------------------------------------------

enum MediaFileType {
  IMAGE
  AUDIO
  PDF
  DOCUMENT
}

/// Teacher-created folders (Reading / Listening / Articles / Speaking /
/// Resources are just the suggested starting set — not a DB enum, so a
/// teacher can add their own too).
model MediaFolder {
  id   String @id @default(cuid())
  name String

  ownerId String
  owner   TeacherProfile @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  files MediaFile[]

  @@unique([ownerId, name])
  @@map("media_folders")
}

/// One row per real uploaded file. `path`/`thumbnailPath` are servable
/// URLs, same convention as every other upload field in this schema
/// (Passage.audioPath, Article.coverImagePath, PassageAttachment.imagePath).
model MediaFile {
  id String @id @default(cuid())

  fileName String
  /// Phase 47 — a real teacher-set display title, distinct from the raw uploaded fileName. Null until a teacher sets one (falls back to fileName for display).
  title       String?
  /// Phase 47 — a real teacher-set description. Null until a teacher sets one.
  description String? @db.Text
  type     MediaFileType
  mimeType String
  path     String
  /// Bytes — read from the real uploaded file, never estimated. The basis for the 5GB teacher storage quota.
  size     Int
  /// Phase 47 — SHA-256 of the ORIGINAL uploaded bytes (before any image compression), used to detect and skip re-uploading a file this teacher already has in their library ("avoid duplicate uploads"). Null for every file uploaded before this existed.
  contentHash String?

  /// Real pixel dimensions, only ever set for type=IMAGE (read from the file itself via sharp, never guessed) — used to give next/image real width/height and avoid layout shift.
  width         Int?
  height        Int?
  /// A real compressed+resized preview generated at upload time, only for type=IMAGE. Null for audio/pdf/documents, and for any image where thumbnail generation failed (the original still serves fine either way).
  thumbnailPath String?

  folderId String?
  folder   MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  ownerId String
  owner   TeacherProfile @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  usages             MediaUsage[]
  passageAttachments PassageAttachment[]
  articleAttachments ArticleAttachment[]
  writingTaskVisuals WritingTask[]

  @@index([ownerId, type])
  @@index([ownerId, folderId])
  @@index([ownerId, createdAt])
  @@index([ownerId, contentHash])
  @@map("media_files")
}

/// What a MediaFile is reused BY — Reading/Listening (PassageAttachment) and
/// Articles (cover or an ArticleAttachment) today, more contexts later
/// without a schema change. Polymorphic by `context` + `referenceId` (the
/// referenced row's own id) rather than several nullable FK columns, since
/// the set of "things that can reuse a file" is expected to keep growing.
/// `referenceId` is deliberately not a real FK (the target table varies by
/// context) — the referencing side is responsible for deleting its own
/// MediaUsage row when it deletes itself (see deletePassageAttachment /
/// deleteArticleAttachment).
enum MediaUsageContext {
  PASSAGE_ATTACHMENT
  ARTICLE_COVER
  ARTICLE_ATTACHMENT
  WRITING_TASK_VISUAL
  /// Phase 47 — Skill Media Library's content thumbnails/cover banners.
  MOCK_TEST_COVER
  WRITING_TASK_COVER
  SPEAKING_TASK_COVER
  SKILL_COVER
}

model MediaUsage {
  id String @id @default(cuid())

  mediaFileId String
  mediaFile   MediaFile @relation(fields: [mediaFileId], references: [id], onDelete: Cascade)

  context     MediaUsageContext
  referenceId String

  createdAt DateTime @default(now())

  @@index([mediaFileId])
  @@index([context, referenceId])
  @@map("media_usages")
}

/// Phase 47 — Skill Media Library's platform-wide cover banner (e.g.
/// "Cambridge Reading Collection" on the Reading landing page). Exactly one
/// row per skill (skill IS the primary key — SkillType only ever has 4
/// values) — PLATFORM-WIDE, not per-teacher, because the Reading/Listening
/// catalog pages these banners appear on (getGeneralTestsByType) already
/// pool every teacher's published tests together with no single "owning"
/// teacher; a Root Teacher manages these 4 banners for every student,
/// mirroring every other platform-wide setting already gated on
/// isRootTeacher (analytics, teacher management, subscription plans, ...).
model SkillCoverImage {
  skill SkillType @id

  title       String
  description String? @db.Text
  imagePath   String

  updatedById String
  updatedBy   TeacherProfile @relation(fields: [updatedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("skill_cover_images")
}

/// Phase 38 — Part 5's "Optional: Inline Images, Infographics, Attachments"
/// for articles — same shape/reasoning as PassageAttachment (Phase 35): a
/// real uploaded image, teacher-facing type label only.
enum ArticleAttachmentType {
  IMAGE
  INFOGRAPHIC
  ATTACHMENT
}

model ArticleAttachment {
  id        String  @id @default(cuid())
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  type       ArticleAttachmentType
  imagePath  String
  caption    String?
  orderIndex Int                   @default(0)

  /// Set only when this attachment was picked from the Media Library rather than uploaded fresh — null for a direct upload, same optionality convention as PassageAttachment.mediaFileId.
  mediaFileId String?
  mediaFile   MediaFile? @relation(fields: [mediaFileId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@map("article_attachments")
}
